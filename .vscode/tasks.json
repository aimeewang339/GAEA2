{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build GAEA2",
      "type": "process",
      "command": "javac",
      "args": [
        "--release",
        "21",
        "-d",
        "out",
        "@sources.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ]
    }
  ]
}
